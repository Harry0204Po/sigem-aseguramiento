{
  "name": "sigem-aseguramiento",
  "version": "1.1.0",
  "description": "SIGEM - Sistema Integral de Gestión Electromecánica. Prototipo funcional y suite de pruebas para el curso de Aseguramiento de la Calidad de Software (UMG).",
  "private": true,
  "scripts": {
    "start": "http-server . -p 8080 -c-1 -o",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:all": "jest && playwright test"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.js",
      "<rootDir>/tests/integration/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/js/logica.js",
      "src/js/datos-demo.js"
    ],
    "verbose": true,
    "globalSetup": "<rootDir>/tests/helpers/zona-horaria.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0"
  },
  "license": "UNLICENSED"
}
